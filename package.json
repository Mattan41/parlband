{
  "name": "parlband",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:d1": "concurrently -k -n \"next,wrangler\" -c \"cyan,magenta\" \"next dev --port 3000\" \"wrangler pages dev --port=8788 --proxy=3000\"",
    "build": "next build",
    "preview": "npm run build && wrangler pages dev out",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply parlband-db --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && wrangler d1 execute parlband-db --local --file=seeds.sql",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next dist out build"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
